# copy shape used by fine-tuning/setup_secrets.sh -> /workspace/.env (chmod 600)
# never commit a real .env. hf token is not stored here (hf auth login -> /workspace/hf/token)
# every pod: set -a; source /workspace/.env; set +a

export HF_HOME=/workspace/hf
export HF_XET_HIGH_PERFORMANCE=1
export WANDB_API_KEY=
